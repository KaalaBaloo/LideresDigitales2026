# --- Supabase (Postgres gestionado) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<service-role-key>            # solo backend; nunca en el frontend
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# --- Hugging Face Inference Providers (solo servicio edge) ---
HF_TOKEN=hf_xxx                            # permiso "Inference Providers"
HF_PROVIDER=hf-inference
DETECTOR_MODEL=facebook/detr-resnet-50
DETECTOR_THRESHOLD=0.7

# --- Anthropic (redactor; recibe SOLO JSON, nunca imágenes) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Servicios ---
CORS_ORIGINS=https://<firebase-project>.web.app,http://localhost:5173
API_URL=https://hora-valle-api.onrender.com
EDGE_URL=https://hora-valle-edge.onrender.com
SENSOR_API_KEY=<secreto-compartido-edge-api>
